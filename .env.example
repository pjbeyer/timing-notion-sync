# Timing API Token
# Get from: Timing.app → Preferences → Web API
TIMING_API_TOKEN=your_timing_token_here

# Notion Integration Token  
# Get from: https://www.notion.so/my-integrations
NOTION_API_TOKEN=your_notion_token_here

# Notion Database ID
# Get from your Notion database URL
NOTION_DATABASE_ID=your_database_id_here

# Multi-database routing (optional)
# Map a Timing project root/folder to a specific Notion database ID.
# Projects whose top-level folder is a key here are synced to that database;
# everything else goes to NOTION_DATABASE_ID.
# Example: {"Work": "db123...", "Family": "db456..."}
# PROJECT_DB_MAP={"Work":"your_work_db_id_here","Family":"your_family_db_id_here"}

# Enhanced Sync Options (optional)
# Sync individual time entries with titles/notes (requires Notion properties: Entry Count, Top Entries)
SYNC_ENTRIES=false

# Sync macOS ScreenTime data (requires Full Disk Access, properties: Active Hours, Screen Events, Top Apps)
SYNC_SCREENTIME=false

# Number of top apps to include in ScreenTime summary
SCREENTIME_TOP_APPS=5