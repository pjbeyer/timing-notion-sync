# Timing API Token
# Get from: Timing.app → Preferences → Web API
TIMING_API_TOKEN=your_timing_token_here

# Notion Integration Token  
# Get from: https://www.notion.so/my-integrations
NOTION_API_TOKEN=your_notion_token_here

# Notion Database ID
# Get from your Notion database URL
NOTION_DATABASE_ID=your_database_id_here

# Multi-database routing (optional)
# Map a Timing project root/folder to a specific Notion database ID.
# Projects whose top-level folder is a key here are synced to that database;
# everything else goes to NOTION_DATABASE_ID.
# Example: {"Work": "db123...", "Family": "db456..."}
# PROJECT_DB_MAP={"Work":"your_work_db_id_here","Family":"your_family_db_id_here"}

# Multi-workspace routing (optional)
# Route project folders to different Notion workspaces. Each workspace lists a
# token_env (the env var holding that workspace's Notion API token) and its
# own databases by project folder. WORKSPACE_MAP maps a project root folder to
# a workspace name; a folder not listed uses the default workspace
# (NOTION_API_TOKEN + NOTION_DATABASE_ID / PROJECT_DB_MAP).
# WARNING: routing is structural, so family projects can never be written to a
# work workspace and vice versa. Only map a folder to a workspace you intend.
# WORKSPACES={"gsd":{"token_env":"NOTION_API_TOKEN","databases":{"Family":"db_family"}},"flex":{"token_env":"NOTION_API_TOKEN_FLEX","databases":{"Work":"db_work"}}}
# WORKSPACE_MAP={"Family":"gsd","Work":"flex"}

# Enhanced Sync Options (optional)
# Sync individual time entries with titles/notes (requires Notion properties: Entry Count, Top Entries)
SYNC_ENTRIES=false

# Propagate Timing entry custom_fields (device-scoped enrichment markers) into
# the Notion page content. Only effective with SYNC_ENTRIES=true. Read-only:
# the sync never writes custom_fields back to Timing.
SYNC_CUSTOM_FIELDS=false

# Sync macOS ScreenTime data. Source defaults to "timing" (FDA-free, works
# under launchd); set "knowledgec" for Apple's knowledgeC.db (needs Full Disk
# Access). Requires Notion properties: Active Hours, Screen Events, Top Apps.
SYNC_SCREENTIME=false

# ScreenTime data source: "timing" (Timing.app SQLite AppActivity, FDA-free) or
# "knowledgec" (Apple knowledgeC.db, requires Full Disk Access).
SCREENTIME_SOURCE=timing

# Number of top apps to include in ScreenTime summary
SCREENTIME_TOP_APPS=5

# Run the sync even when the system has been idle (default skips when idle >
# IDLE_THRESHOLD_SECONDS). Useful so a launchd sync updates Notion regardless
# of idle state.
SYNC_WHEN_IDLE=false
# Idle threshold in seconds before the sync skips (unless SYNC_WHEN_IDLE=true).
IDLE_THRESHOLD_SECONDS=300